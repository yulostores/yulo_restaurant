# Copy to .env for LOCAL DEVELOPMENT only:  cp .env.example .env
#
# .env is gitignored and never reaches Vercel. Vercel builds from a fresh
# checkout on every push, so a .env file cannot survive a deploy.
# Production values go in: Vercel -> Project Settings -> Environment Variables
# (scoped to Production). See DEPLOYMENT.md in the yulo_backend repo.
#
# NOTE: VITE_* values are inlined into the JS bundle AT BUILD TIME. Changing one
# in Vercel requires a redeploy to take effect, and the value ends up publicly
# readable in the bundle — never put a secret here.

# Prefix for API requests. Leave blank in development to use the Vite dev proxy
# (see vite.config.js). In production point it at your DigitalOcean backend,
# e.g. VITE_API_BASE=https://your-backend.ondigitalocean.app
VITE_API_BASE=

# Socket.IO origin. Defaults to VITE_API_BASE when unset.
# VITE_SOCKET_URL=

# Dev-only: where the Vite proxy forwards /api, /partner and /health.
# VITE_PROXY_TARGET=http://localhost:3000
